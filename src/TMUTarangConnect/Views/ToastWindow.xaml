<Window x:Class="TMUTarangConnect.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification"
        Height="84" Width="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Fade in & slide animation -->
        <Storyboard x:Key="ShowAnim">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
            <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="20" To="0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="HideAnim">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.2" />
        </Storyboard>
    </Window.Resources>

    <Border x:Name="MainBorder"
            Background="#1B1D24"
            BorderBrush="#2C303E"
            BorderThickness="1"
            CornerRadius="12"
            Margin="6"
            Cursor="Hand"
            MouseLeftButtonUp="OnCardClicked">
        <Border.RenderTransform>
            <TranslateTransform />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.45" />
        </Border.Effect>

        <Grid>
            <!-- Left Accent Pill -->
            <Border x:Name="AccentBar"
                    Width="4"
                    HorizontalAlignment="Left"
                    Background="#10B981"
                    CornerRadius="2"
                    Margin="10,12,0,12" />

            <!-- App Logo / Status Icon -->
            <Image x:Name="ImgIcon"
                   Width="38" Height="38"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Margin="24,0,0,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- Text Content -->
            <StackPanel VerticalAlignment="Center" Margin="74,0,32,0">
                <TextBlock x:Name="TxtTitle"
                           Text="TMU WiFi Connected"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontWeight="SemiBold"
                           FontSize="13.5"
                           Foreground="#FFFFFF"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TxtMessage"
                           Text="Internet access restored successfully!"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="11.5"
                           Foreground="#94A3B8"
                           TextWrapping="Wrap"
                           MaxHeight="32"
                           Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Close Button (✕) -->
            <Button x:Name="BtnClose"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,8,0"
                    Width="24" Height="24"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OnCloseClicked">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="12">
                            <TextBlock Text="✕"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2D3243" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
