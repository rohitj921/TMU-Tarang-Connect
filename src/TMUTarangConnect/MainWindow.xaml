<Window x:Class="TMUTarangConnect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TMU Tarang Connect"
        Height="750" Width="710"
        MinWidth="680" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C10"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanMinimize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      CornerRadius="10"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="4"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Sleek Minimalist ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#2A2F3D" CornerRadius="3" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Input TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#141722" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#252A38" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern PasswordBox -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#141722" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#252A38" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1A1F2C" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderBrush" Value="#2A3245" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#242B3D" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger / Logout Button -->
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#1C1318" />
            <Setter Property="Foreground" Value="#F87171" />
            <Setter Property="BorderBrush" Value="#3D1D23" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button (Minimize) -->
        <Style x:Key="WindowControlBtn" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" VerticalAlignment="Center" HorizontalAlignment="Center" Width="36" Height="28">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E2536" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Close Button -->
        <Style x:Key="WindowCloseBtn" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" VerticalAlignment="Center" HorizontalAlignment="Center" Width="36" Height="28">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E11D48" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,6" />
        </Style>

        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- Outer Window Border for sleek custom framing -->
    <Border Background="#0B0C10" BorderBrush="#1C212E" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0. Custom Sleek Header & Title Bar -->
                <RowDefinition Height="44" />
                <!-- 1. Connection Telemetry Dashboard Card -->
                <RowDefinition Height="Auto" />
                <!-- 2. Main Tabs (Locked Single-Row Navbar) -->
                <RowDefinition Height="*" />
                <!-- 3. Bottom Footer Action Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. MODERN FLUENT DARK TITLE BAR -->
            <Border Grid.Row="0" Background="#0E111A" BorderBrush="#1C212E" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                <Grid Margin="12,0,6,0">
                    <!-- Left: Brand Logo & Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Image x:Name="ImgAppIcon" Width="22" Height="22" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="TMU Tarang Connect" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" VerticalAlignment="Center" />
                        <Border Background="#16233B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="FortiGate Client" FontSize="10" FontWeight="SemiBold" Foreground="#60A5FA" />
                        </Border>
                    </StackPanel>

                    <!-- Right: Window Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowControlBtn}" Content="─" Click="OnMinimizeWindowClicked" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize to Taskbar" />
                        <Button Style="{StaticResource WindowCloseBtn}" Content="✕" Click="OnCloseToTrayClicked" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close to System Tray" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Interior Content Area -->
            <Grid Grid.Row="1" Margin="16,14,16,0">
                <!-- 1. TRANSPARENT NETWORK TELEMETRY CARD -->
                <Border Background="#12151F"
                        BorderBrush="#1F2535"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header Row: Live Status Dot, Label, Active Account Badge, Uptime -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="StatusDotGlow" CornerRadius="10" Padding="4" Margin="0,0,8,0">
                                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#10B981" />
                                </Border>
                                <TextBlock x:Name="TxtStatus" Text="Online (Connected)" FontWeight="Bold" FontSize="14.5" Foreground="#F8FAFC" />
                                
                                <Border Background="#16233B" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👤 " FontSize="10" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtActiveAccountBadge" Text="Primary Account" FontSize="10.5" FontWeight="SemiBold" Foreground="#60A5FA" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TxtUptime" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="Connected for: --" FontSize="12.5" Foreground="#94A3B8" />
                        </Grid>

                        <!-- Detailed Network Telemetry 4-Column Grid -->
                        <Grid Grid.Row="1" Margin="0,12,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Assigned IP -->
                            <Border Grid.Column="0" Background="#0C0E14" CornerRadius="8" Padding="10,8" Margin="0,0,4,0" BorderBrush="#1C212E" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="ASSIGNED IP" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtAssignedIp" Text="172.14.2.253" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Latency -->
                            <Border Grid.Column="1" Background="#0C0E14" CornerRadius="8" Padding="10,8" Margin="4,0,4,0" BorderBrush="#1C212E" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="LATENCY" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtLatency" Text="-- ms" FontSize="12.5" FontWeight="Bold" Foreground="#34D399" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Download / Upload Speed -->
                            <Border Grid.Column="2" Background="#0C0E14" CornerRadius="8" Padding="10,8" Margin="4,0,4,0" BorderBrush="#1C212E" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="SPEED" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtSpeed" Text="-- Mbps" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Data Consumed Today -->
                            <Border Grid.Column="3" Background="#0C0E14" CornerRadius="8" Padding="10,8" Margin="4,0,0,0" BorderBrush="#1C212E" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="DATA TODAY" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtTopDataToday" Text="0 MB" FontSize="12.5" FontWeight="Bold" Foreground="#A78BFA" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Actions Row -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnSpeedTest" Content="⚡ Speed Test" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="OnSpeedTestClicked" />
                            <Button x:Name="BtnCheck" Content="Check Connection" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="OnCheckConnectionClicked" />
                            <Button x:Name="BtnConnect" Content="Connect Now" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="OnConnectNowClicked" />
                            <Button Content="Logout" Style="{StaticResource DangerBtn}" Click="OnLogoutClicked" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. TABBED SECTIONS (LOCKED SINGLE-ROW NAVBAR - 6 BALANCED TABS) -->
            <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="16,10,16,6">
                <!-- Force strict single row of 6 equal tabs -->
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>

                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="tabBorder" Background="#0E121B" BorderThickness="0,0,0,2" BorderBrush="#1C2230" Padding="6,10" Margin="2,0" CornerRadius="6,6,0,0" Cursor="Hand">
                                        <TextBlock Text="{TemplateBinding Header}" FontSize="11.5" FontWeight="SemiBold" Foreground="#8492A6" x:Name="tabText" HorizontalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="tabBorder" Property="Background" Value="#171F30" />
                                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="#3B82F6" />
                                            <Setter TargetName="tabText" Property="Foreground" Value="#60A5FA" />
                                            <Setter TargetName="tabText" Property="FontWeight" Value="Bold" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="tabText" Property="Foreground" Value="#E2E8F0" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: Credentials & Multi-Account Switcher (LUXURIOUS FULL-WIDTH VIEW) -->
                <TabItem Header="Credentials">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 1. Header Bar: Title, Count Badge, and + Add Account Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔑" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="CREDENTIAL POOL" FontSize="11.5" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                <Border Background="#16233B" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtPoolCountBadge" Text="2 ACCOUNTS" FontSize="9.5" FontWeight="Bold" Foreground="#60A5FA" />
                                </Border>
                            </StackPanel>

                            <Button Content="+ Add Account" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right"
                                    Padding="14,6" FontSize="11.5" Click="OnAddNewAccountClicked" ToolTip="Add a new campus account to your rotation pool" />
                        </Grid>

                        <!-- 2. Accounts List (Full-width, interactive rows with click to edit) -->
                        <Border Grid.Row="1" Background="#0C0E14" CornerRadius="8" Padding="6" BorderBrush="#1C212E" BorderThickness="1" Margin="0,0,0,10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="AccountsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding CardBackground}" CornerRadius="8" Padding="12,10" Margin="0,0,0,6"
                                                    BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" Cursor="Hand"
                                                    Tag="{Binding Id}" PreviewMouseLeftButtonUp="OnCardRowClicked"
                                                    ToolTip="Click to edit account details">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icon Pill -->
                                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" Background="#16233B" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="🔑" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Account Info -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                                            <Border Background="#1E3A8A" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="ACTIVE" FontSize="9" FontWeight="Bold" Foreground="#93C5FD" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Username}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <!-- Status Badge -->
                                                    <Border Grid.Column="2" Background="{Binding StatusBadgeBg}" CornerRadius="4" Padding="7,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LastStatus}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding StatusBadgeColor}" />
                                                    </Border>

                                                    <!-- Switch / Active Indicator -->
                                                    <Button Grid.Column="3" Content="{Binding SwitchButtonText}" IsEnabled="{Binding CanSwitch}"
                                                            Style="{StaticResource SecondaryBtn}" Padding="10,5" FontSize="11" Margin="0,0,6,0"
                                                            Tag="{Binding Id}" Click="OnSwitchAccountClicked" ToolTip="Switch session to this account" />

                                                    <!-- Delete Button -->
                                                    <Button Grid.Column="4" Content="✕" Style="{StaticResource DangerBtn}" Padding="8,5" FontSize="11"
                                                            Tag="{Binding Id}" Click="OnDeleteAccountClicked" ToolTip="Remove from pool" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- 3. Lower Section: 2 Balanced Cards (Preferences & Failover Engine) -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- System Preferences Card -->
                            <Border Grid.Column="0" Background="#10131B" CornerRadius="8" Padding="14,12" Margin="0,0,6,0" BorderBrush="#1C212E" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="⚙️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="SYSTEM PREFERENCES" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkNotifications" Content="Show floating toast notifications" Margin="0,2,0,6" />
                                    <CheckBox x:Name="ChkStartup" Content="Launch minimized on Windows startup" Margin="0,2,0,8" />
                                    <Button Content="Test Notification Banner" Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Left" Padding="12,5" FontSize="11" Click="OnTestToastClicked" />
                                </StackPanel>
                            </Border>

                            <!-- Failover & Rotation Rules Card (Zero cut off, gorgeous typography) -->
                            <Border Grid.Column="1" Background="#10131B" CornerRadius="8" Padding="14,12" Margin="6,0,0,0" BorderBrush="#1C212E" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="🔄" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="FORTIGATE FAILOVER ENGINE" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkAutoRotate" Content="Auto-rotate on 2-device limit or error" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,2,0,6" />
                                    <TextBlock Text="• FortiGate limits each account to 2 active devices." FontSize="10.5" Foreground="#94A3B8" Margin="0,2,0,2" />
